      "boundElements": [],
      "updated": 1776504421609,
      "link": null,
      "locked": false,
      "text": "1. Strategy Pattern\n   Limiter interface with pluggable\n   algorithm implementations\n\n2. Factory Pattern\n   LimiterFactory creates the correct\n   Limiter from EndpointConfig\n\n3. ConcurrentMap per-key state\n   Thread-safe per-client counters",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Strategy Pattern\n   Limiter interface with pluggable\n   algorithm implementations\n\n2. Factory Pattern\n   LimiterFactory creates the correct\n   Limiter from EndpointConfig\n\n3. ConcurrentMap per-key state\n   Thread-safe per-client counters",
      "autoResize": true,
      "lineHeight": 1.25
    },
